{
	"name": "@5nkr/webcore",
	"version": "1.0.2",
	"description": "Utilities, resources & GIFs focused on replicating and accessing the weird elements of early 2000s internet",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "tsx --watch scripts/include/webcore.ts",
		"build": "tsx scripts/build.ts && tsc --pretty && prettier --write src/lib/*.d.ts",
		"draft": "npm run build && mkdir dist && npm pack --pack-destination=./dist",
		"publish": "npm run build && npm login && npm publish --access public"
	},
	"keywords": [
		"webcore",
		"gifs",
		"util"
	],
	"files": [
		"src"
	],
	"exports": {
		".": {
			"default": "./src/lib/webcore.js",
			"types": "./src/lib/webcore.d.ts"
		},
		"./gifs/*": "./src/img/gif/*",
		"./intl": "./src/lib/webcore-intl.d.ts",
		"./src/*": "./src/*"
	},
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
